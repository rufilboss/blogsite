---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedArticles, author } from '../../data/articles';

const filters = ['all', 'security', 'aws', 'devsecops', 'kubernetes', 'ci/cd'];
---

<SiteLayout title="Writing Archive" description="Published articles and writing by Ilyas Rufai across Hashnode, Dev.to, Reclear, and freeCodeCamp." currentPath="/writing">
  <main>
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Writing Archive</div>
          <h1>Published articles by {author.name}</h1>
        </div>
      </div>

      <div class="filter-row" aria-label="Article filters">
        {filters.map((filter) => (
          <button
            class="filter"
            type="button"
            data-filter={filter}
            aria-selected={filter === 'all' ? 'true' : 'false'}
            aria-controls="article-list"
          >{filter}</button>
        ))}
      </div>

      <div class="card-list" id="article-list">
        {publishedArticles.map((article) => (
          <article class="article-card" data-category={article.category.toLowerCase()}>
            <div class="card-meta">
              <span>{article.platform}</span>
              <span>{article.date}</span>
              <span>{article.category}</span>
            </div>
            <h3><a href={article.url} target="_blank" rel="noreferrer">{article.title}</a></h3>
            <p>Read the original article on {article.platform}.</p>
          </article>
        ))}
      </div>
    </div>
  </main>
</SiteLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const articleCards = document.querySelectorAll<HTMLElement>('[data-category]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedFilter = button.dataset.filter;

      filterButtons.forEach((filterButton) => {
        filterButton.setAttribute('aria-selected', String(filterButton === button));
      });

      articleCards.forEach((card) => {
        const isVisible = selectedFilter === 'all' || card.dataset.category === selectedFilter;
        card.hidden = !isVisible;
      });
    });
  });
</script>
