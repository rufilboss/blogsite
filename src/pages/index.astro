---
import SiteLayout from '../layouts/SiteLayout.astro';
import { author, publishedArticles } from '../data/articles';

const featured = publishedArticles.slice(0, 4);
const topics = ['Platform Engineering', 'DevSecOps', 'Security Automation', 'Cloud & AWS'];
---

<SiteLayout title="Published Articles" description="DevSecOps writing and cloud security articles by Ilyas Rufai." currentPath="/">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Published Articles</div>
        <h1>Engineering systems that stay humane under pressure.</h1>
        <p class="hero-copy">
          I’m {author.name}, and I write about platform thinking, secure defaults, and the operating realities behind dependable product delivery.
        </p>
      </div>
      <aside class="hero-aside">
        <div class="eyebrow">Current focus</div>
        <p>DevSecOps engineering, cloud security, and technical writing for teams shipping critical systems at scale.</p>
      </aside>
    </div>
  </section>

  <main>
    <div class="container content-grid">
      <div>
        <div class="section-heading">
          <h2>Featured writing</h2>
          <a href="/writing">Browse archive</a>
        </div>

        <div class="card-list">
          {featured.map((article) => (
            <article class="article-card">
              <div class="card-meta">
                <span>{article.platform}</span>
                <span>{article.date}</span>
                <span>{article.category}</span>
              </div>
              <h3><a href={article.url} target="_blank" rel="noreferrer">{article.title}</a></h3>
              <p>{article.platform} article from the real Ilyas Rufai publication archive.</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="sidebar">
        <h3>Reading list</h3>
        <ul class="topic-list">
          {topics.map((topic) => (
            <li><a href="/writing"><span>{topic}</span><span>→</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </main>
</SiteLayout>
